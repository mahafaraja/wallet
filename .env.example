# Google Drive backup configuration
# Create an OAuth 2.0 client ID in Google Cloud Console:
#   1. Enable the Google Drive API
#   2. Create credentials > OAuth client ID (Web application)
#   3. Add your redirect URI, e.g. http://localhost:5173/oauth-callback
#   4. Copy the client ID below
#
# Then copy this file to .env and fill in the values.

VITE_GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: override the OAuth redirect URI (must match Google Cloud Console)
# VITE_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/oauth-callback